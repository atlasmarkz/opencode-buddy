{
  "name": "@mark_future_ai/opencode-buddy",
  "version": "1.1.1",
  "description": "A virtual pet companion for opencode: an ASCII buddy in the TUI sidebar and a floating SVG pet in OpenCode Desktop. Hatches, feeds, plays, and reacts to what you're coding.",
  "type": "module",
  "main": "src/server-plugin.js",
  "exports": {
    ".": "./src/server-plugin.js",
    "./tui": "./src/tui-plugin.jsx",
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "assets",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "pet",
    "tamagotchi",
    "ascii",
    "desktop-pet",
    "floating-pet",
    "companion",
    "buddy",
    "virtual-pet",
    "sidebar"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:gui": "vite build",
    "prepack": "npm run build:gui",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "author": "AMark-CS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AMark-CS/opencode-buddy.git"
  },
  "bugs": {
    "url": "https://github.com/AMark-CS/opencode-buddy/issues"
  },
  "homepage": "https://github.com/AMark-CS/opencode-buddy#readme",
  "dependencies": {
    "@opencode/plugin": "^2.2.6"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.15"
  }
}
